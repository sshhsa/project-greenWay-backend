# Шаблон змінних оточення. Скопіюй у .env і заповни: cp .env.template .env
# Сам .env НЕ комітимо!
PORT=4000
NODE_ENV=development

# MongoDB Atlas
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority
MONGO_DNS_SERVER=

# Через кому, без пробілів: локальний фронт + продакшн фронт (Vercel)
FRONTEND_URLS=http://localhost:3000,https://project-greenway-frontend.vercel.app

# Cloudinary (завантаження зображень локацій)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Тестовий користувач (npm run seed:user)
TEST_USER_EMAIL=test@greenway.dev
TEST_USER_PASSWORD=Test12345
